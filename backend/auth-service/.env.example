# Server
PORT=3001
SERVICE_NAME=auth-service
NODE_ENV=development

# Database (auth_schema in the shared Postgres instance)
DATABASE_URL=postgresql://auth_user:auth_password@localhost:5432/jhanvi_cars
DB_SCHEMA=auth_schema

# Auth / Token provider
# "local" = local JWT signing (Phase 1). Later: "cognito" / "oidc".
AUTH_PROVIDER=local
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=1h
# Production: path to the mounted AWS Secrets Manager secret file.
# Leave unset for local development.
SECRET_FILE_PATH=

# Internal Driver Service
DRIVER_SERVICE_URL=http://localhost:3003
INTERNAL_SERVICE_TOKEN=replace-with-internal-service-token
