pipeline {
 agent any

 // ==== GLOBAL SETTINGS ====
 environment {
 // Git repo
 REPO_URL = 'https://github.com/your-org/your-app.git'
 // Docker
 IMAGE_NAME = 'your-registry.amazonaws.com/your-app'
 IMAGE_TAG = "${env.BUILD_NUMBER}"
 // SonarQube
 SONAR_HOST_URL = 'https://sonarqube.yourdomain.com'
 SONAR_TOKEN = credentials('sonarqube-token')
 // AWS/EKS
 AWS_REGION = 'us-east-1'
 EKS_CLUSTER = 'your-eks-cluster'
 KUBE_CONFIG = credentials('aws-eks-kubeconfig')
 // Maven/Gradle (adjust if using npm, etc.)
 MAVEN_OPTS = '-Dmaven.repo.local=$WORKSPACE/.m2/repository'
 }

 // ==== TOOLS ====
 tools {
 maven 'Maven 3.8.6' // adjust name to your Maven installation
 jdk 'OpenJDK 11' // adjust JDK version
 }

 stages {

 stage('Checkout') {
 steps {
 git url: "${env.REPO_URL}", branch: 'main'
 }
 }

 stage('Compile & Unit Test') {
 steps {
 sh 'mvn clean compile test'
 }
 }

 stage('Static Code Analysis') {
 steps {
 withSonarQubeEnv('SonarQubeServer') {
 sh """
 mvn sonar:sonar \
 -Dsonar.projectKey=your-app \
 -Dsonar.host.url=${env.SONAR_HOST_URL} \
 -Dsonar.login=${env.SONAR_TOKEN}
 """
 }
 }
 }

 stage('Quality Gate') {
 steps {
 timeout(time: 2, unit: 'MINUTES') {
 waitForQualityGate abortPipeline: true
 }
 }
 }

 stage('Build Docker Image') {
 steps {
 script {
 // Build image with Maven Docker plugin or plain Docker CLI
 sh """
 docker build -t ${env.IMAGE_NAME}:${env.IMAGE_TAG} .
 """
 }
 }
 }

 stage('Push Image to Registry') {
 steps {
 withCredentials() {
 sh """
 aws ecr get-login-password --region ${env.AWS_REGION} |
 docker login --username AWS --password-stdin ${env.IMAGE_NAME}
 docker push ${env.IMAGE_NAME}:${env.IMAGE_TAG}
 """
 }
 }
 }

 stage('Configure kubectl') {
 steps {
 withCredentials() {
 writeFile file: "${env.WORKSPACE}/kubeconfig", text: readFile(env.KUBECONFIG)
 sh """
 export KUBECONFIG=${env.WORKSPACE}/kubeconfig
 aws eks update-kubeconfig --region ${env.AWS_REGION} --name ${env.EKS_CLUSTER}
 """
 }
 }
 }

 stage('Deploy to EKS') {
 steps {
 script {
 // Option 1: plain kubectl manifest
 sh """
 export KUBECONFIG=${env.WORKSPACE}/kubeconfig
 kubectl set image deployment/your-app your-app=${env.IMAGE_NAME}:${env.IMAGE_TAG} --record
 kubectl rollout status deployment/your-app
 """
 // Option 2: Helm (uncomment if using Helm)
 // sh """
 // helm upgrade --install your-app ./helm-chart \\
 // --set image.repository=${env.IMAGE_NAME} \\
 // --set image.tag=${env.IMAGE_TAG}
 // """
 }
 }
 }
 }

 post {
 always {
 cleanWs()
 }
 success {
 echo 'Pipeline completed successfully!'
 }
 failure {
 echo 'Pipeline failed. Check the logs above.'
 }
 }
}
